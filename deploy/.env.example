# =============================================================================
# WealthMe — deploy/.env.example
# =============================================================================
# This file mirrors the root .env.example for the dev server.
# On the server: copy the repo root .env.example to .env at the repo root,
# fill in real values, and run from the repo root:
#
#   docker compose -f docker-compose.yml -f deploy/docker-compose.yml up -d --build
#
# NEVER commit a real .env file.
# See the root .env.example for the authoritative variable reference.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wealthme
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wealthme_dev
POSTGRES_PORT=5432

# Full connection URL — uses 'postgres' service name (not localhost) in compose.
DATABASE_URL=postgresql://wealthme:change-me-in-production@postgres:5432/wealthme_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
API_PORT=4000
WEB_ORIGIN=http://your-server-domain:3000

JWT_SECRET=replace-with-32-char-random-string-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=replace-with-64-hex-chars-generated-by-openssl-rand-hex-32

# ── Better Auth (Next.js web) ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-base64-random-string
BETTER_AUTH_URL=http://your-server-domain:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://your-server-domain:4000/auth/google/callback

# ── MinIO / Object Storage ────────────────────────────────────────────────────
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=wealthme-uploads

# ── Mail ──────────────────────────────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@wealthme.local

# ── Web App URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://your-server-domain:3000
NEXT_PUBLIC_API_URL=http://your-server-domain:4000
# Server-side (SSR) API URL — use docker service name inside compose.
API_URL=http://api:4000
WEB_PORT=3000

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Optional integrations ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
BRICK_CLIENT_ID=
BRICK_CLIENT_SECRET=
USE_REAL_MARKET_DATA=true
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@wealthme.app
SENTRY_DSN=
