# WealthMe API — Environment Variables
# Copy to .env and fill in real values

# Core
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/wealthme

# Cache (required)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-32-byte-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-generate-another-32-byte-hex
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional — both required to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Storage / MinIO (optional)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Email (optional legacy — superseded by SendGrid)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Anthropic AI (optional — enables Claude OCR + AI Advisor when set)
ANTHROPIC_API_KEY=

# Open Banking — Brick (optional — both required to enable)
BRICK_CLIENT_ID=
BRICK_CLIENT_SECRET=

# Market data (optional — "true" uses Yahoo Finance)
USE_REAL_MARKET_DATA=false

# Email notifications — SendGrid (optional — both required to enable)
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@wealthme.app

# Encryption at-rest — generate with: openssl rand -hex 32
# REQUIRED in production
ENCRYPTION_KEY=
