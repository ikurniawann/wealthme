# =============================================================================
# WealthMe — Root Environment Variables (SINGLE SOURCE OF TRUTH)
# =============================================================================
# Copy this file to .env at the repo root and fill in real values.
# Both `pnpm dev` (web + api) and docker compose read from this one file.
# NEVER commit .env — it is gitignored.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────

# Node environment — must be 'development', 'test', or 'production'.
NODE_ENV=development

# ── PostgreSQL (infra + connection string) ────────────────────────────────────

# Credentials used by the postgres Docker image.
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=wealthme_dev
POSTGRES_PORT=5432

# Full connection URL (used by Prisma and NestJS).
# In docker compose, replace 'localhost' with 'postgres' (the service name).
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/wealthme_dev

# ── Redis ─────────────────────────────────────────────────────────────────────

# Port exposed by the redis Docker image.
REDIS_PORT=6379

# Full connection URL (used by BullMQ / ioredis).
# In docker compose, replace 'localhost' with 'redis'.
REDIS_URL=redis://localhost:6379

# ── API Server ────────────────────────────────────────────────────────────────

# NestJS HTTP port.
PORT=4000

# Allowed web origin for CORS.
WEB_ORIGIN=http://localhost:3000

# ── Authentication (NestJS JWT) ───────────────────────────────────────────────

# Sign JWT access tokens — generate with: openssl rand -hex 32
# Must be at least 32 characters.
JWT_SECRET=replace-with-32-char-random-string-here

# JWT access token lifetime.
JWT_EXPIRES_IN=15m

# Sign JWT refresh tokens — generate with: openssl rand -hex 32
# Must be at least 32 characters. Use a different value from JWT_SECRET.
JWT_REFRESH_SECRET=replace-with-another-32-char-random-string

# JWT refresh token lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# ── Better Auth (Next.js web) ─────────────────────────────────────────────────

# Secret for Better Auth session signing — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-base64-random-string

# Canonical URL of the web app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────

# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Object Storage (MinIO / S3-compatible) ────────────────────────────────────

# MinIO root credentials (used by both the Docker image and the API).
# NOTE: do not ship 'minioadmin/minioadmin' — set strong values in the real .env.
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible endpoint (used by the API).
# In docker compose, replace 'localhost' with 'minio'.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=wealthme-uploads

# ── Mail (MailHog in dev) ─────────────────────────────────────────────────────

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# SMTP settings used by the NestJS mailer.
# In docker compose, replace 'localhost' with 'mailhog'.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@wealthme.local

# ── Web App Public URLs (inlined by Next.js at build time) ────────────────────

# Base URL of the web app (exposed to the browser — no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend API (exposed to the browser — no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side API URL used by Next.js SSR / auth callbacks.
# In docker compose this should point to the 'api' service: http://api:4000
API_URL=http://localhost:4000

# ── Encryption at Rest ────────────────────────────────────────────────────────

# 64 hex chars = 32 bytes for AES-256-GCM. Required in production.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-generated-by-openssl-rand-hex-32

# ── Optional Integrations ─────────────────────────────────────────────────────

# Anthropic AI — enables Claude-based receipt OCR / auto-categorization only.
# EPIC-023 G3 (D16): the AI Advisor chat no longer reads this. Each family
# brings its own provider key (Claude/OpenAI/Gemini), stored encrypted via
# PUT /family-groups/:familyGroupId/ai-key. A family with no key configured
# sees the advisor disabled with instructions — this var is never used as a
# silent fallback (that would mean one family paying for another's usage).
ANTHROPIC_API_KEY=

# Brick Open Banking (both required to enable real adapter).
BRICK_CLIENT_ID=
BRICK_CLIENT_SECRET=

# Market data — set to "true" to route saham/kripto through the real
# CoinGecko + Yahoo Finance (.JK) adapters instead of the deterministic mock.
# No API key required for either (both use free public endpoints).
USE_REAL_MARKET_DATA=false

# Email notifications via SendGrid (both required to enable).
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@wealthme.app

# Sentry error tracking (optional).
SENTRY_DSN=

# Structured log level override (default: info in prod, debug in dev).
# LOG_LEVEL=debug
