# =============================================================================
# WealthMe – Local Dev Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed.
# These defaults work out-of-the-box with docker-compose.yml.
# NEVER commit .env — it is gitignored.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wealthme
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wealthme_dev
POSTGRES_PORT=5432

# Composed URL (used by Prisma / app)
DATABASE_URL=postgresql://wealthme:postgres@localhost:5432/wealthme_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# Composed URL (used by app / BullMQ)
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible endpoint (used by app)
MINIO_ENDPOINT=http://localhost:9000

# ── MailHog (local SMTP catcher) ──────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# SMTP settings for app mailer
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_UI=http://localhost:8025
