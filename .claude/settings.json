{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel deploy --prebuilt --prod:*)",
      "Edit(/checks/approved/**)",
      "Edit(/.claude/loop-kit/score.mjs)",
      "Edit(/.claude/loop-kit/approve-checks.mjs)",
      "Edit(/.scores/**)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guardrail.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  }
}
