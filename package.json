{
  "name": "wealthme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "_ignoredOptionalDependenciesNote": "EPIC-029 — pdfjs-dist declares @napi-rs/canvas as an OPTIONAL dependency, for rendering pages to a bitmap in Node. WealthMe only reads the text layer, in the browser, and never renders (see hooks/statement-pdf.ts). Left alone it pulls ~62 MB of prebuilt native binaries into every install, CI run and Docker layer for code that is never executed and never bundled — pdfjs's own `browser` field already maps `canvas` to false. Excluded here rather than repo-wide via `optional=false`, which would silently drop every other package's optional deps too.",
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ],
    "overrides": {
      "multer": "2.2.0",
      "ws": "8.21.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "socket.io-parser": "^4.2.7",
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "js-yaml@4": "^4.3.0",
      "body-parser": "^2.3.0",
      "brace-expansion": "^1.1.18",
      "js-yaml@3": "^3.15.1",
      "form-data@<4.0.6": "^4.0.6",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "deepmerge-ts@<8": "^8.0.0"
    },
    "patchedDependencies": {
      "exceljs@4.4.0": "patches/exceljs@4.4.0.patch"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "pnpm --filter web",
    "api": "pnpm --filter @wealthme/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@wealthme/config": "workspace:*",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.3.3"
  }
}
