{
  "name": "wealthme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.2.0",
      "ws": "8.21.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "socket.io-parser": "^4.2.7",
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "js-yaml@4": "^4.3.0",
      "body-parser": "^2.3.0",
      "brace-expansion": "^1.1.18"
    },
    "patchedDependencies": {
      "exceljs@4.4.0": "patches/exceljs@4.4.0.patch"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "pnpm --filter web",
    "api": "pnpm --filter @wealthme/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@wealthme/config": "workspace:*",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.3.3"
  }
}
