# =============================================================================
# WealthMe — Web App (apps/web) Environment Variables
# =============================================================================
# Copy this file to apps/web/.env.local and adjust as needed.
# NEVER commit .env.local — it is gitignored.
# For local-service variables (Postgres, Redis, MinIO, MailHog) see the ROOT
# .env.example and docker-compose.yml.
# =============================================================================

# ── Public (inlined at build; safe to expose to the browser) ─────────────────

# [REQUIRED] Base URL of this Next.js app (no trailing slash).
# Used for absolute URLs in metadata, OG tags, and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [REQUIRED] Base URL of the backend API (no trailing slash).
# Used by client-side fetch calls to the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Server-only (never sent to the browser) ──────────────────────────────────

# [OPTIONAL] Next.js runtime environment tag.
# Defaults to 'development' when running via `next dev`.
NODE_ENV=development
