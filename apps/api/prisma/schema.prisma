generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  owner
  member
  admin_staff
}

enum AccountType {
  bank
  ewallet
  cash
  investment
  property
}

enum CategoryKind {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum BudgetPeriod {
  monthly
  weekly
  yearly
}

enum GoalStatus {
  on_track
  needs_boost
  achieved
  at_risk
}

enum InvestmentType {
  saham
  reksa_dana
  obligasi
  emas
  kripto
  lainnya
}

enum LiabilityType {
  kartu_kredit
  pinjaman_pribadi
  kpr
  kendaraan
  lainnya
}

enum InsuranceType {
  jiwa
  kesehatan
  kendaraan
  properti
  lainnya
}

enum InsuranceStatus {
  aktif
  tidak_aktif
  kadaluarsa
}

enum PremiumPeriod {
  monthly
  quarterly
  yearly
}
// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String?
  googleId       String?   @unique
  avatarInitials String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  memberships    Member[]

  @@map("users")
}

model FamilyGroup {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       Member[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  notifications Notification[]
  investments   Investment[]
  liabilities   Liability[]
  insurances    Insurance[]

  @@map("family_groups")
}

model Member {
  id            String      @id @default(uuid())
  userId        String
  familyGroupId String
  role          Role
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, familyGroupId])
  @@index([familyGroupId])
  @@map("members")
}

model Account {
  id            String        @id @default(uuid())
  familyGroupId String
  name          String
  type          AccountType
  institution   String?
  maskedNumber  String?
  balance       BigInt
  currency      String        @default("IDR")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  familyGroup   FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([familyGroupId, name])
  @@index([familyGroupId])
  @@map("accounts")
}

model Category {
  id            String        @id @default(uuid())
  familyGroupId String
  name          String
  kind          CategoryKind
  color         String?
  icon          String?
  createdAt     DateTime      @default(now())
  familyGroup   FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([familyGroupId, name, kind])
  @@index([familyGroupId])
  @@map("categories")
}

model Transaction {
  id            String          @id @default(uuid())
  familyGroupId String
  accountId     String
  categoryId    String?
  amount        BigInt
  type          TransactionType
  description   String?
  occurredAt    DateTime
  createdAt     DateTime        @default(now())
  familyGroup   FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([familyGroupId, occurredAt])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id            String       @id @default(uuid())
  familyGroupId String
  categoryId    String
  period        BudgetPeriod
  limitAmount   BigInt
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, categoryId, period])
  @@index([familyGroupId])
  @@map("budgets")
}

model Goal {
  id              String      @id @default(uuid())
  familyGroupId   String
  name            String
  icon            String?
  targetAmount    BigInt
  currentAmount   BigInt      @default(0)
  targetDate      DateTime?
  autoDebitAmount BigInt?
  status          GoalStatus  @default(on_track)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  familyGroup     FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("goals")
}

model Notification {
  id            String      @id @default(uuid())
  familyGroupId String
  title         String
  body          String
  icon          String?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("notifications")
}

model Investment {
  id               String           @id @default(uuid())
  familyGroupId    String
  ticker           String
  name             String
  type             InvestmentType
  quantity         Decimal          @db.Decimal(18, 8)
  costBasisPerUnit Decimal          @db.Decimal(18, 2)
  currency         String           @default("IDR")
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  familyGroup      FamilyGroup      @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  prices           InvestmentPrice[]

  @@index([familyGroupId])
  @@map("investments")
}

model InvestmentPrice {
  id           String     @id @default(uuid())
  investmentId String
  price        Decimal    @db.Decimal(18, 2)
  source       String     @default("mock")
  recordedAt   DateTime   @default(now())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, recordedAt])
  @@map("investment_prices")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  familyGroupId String?
  action        String
  entity        String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([familyGroupId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Liability {
  id               String        @id @default(uuid())
  familyGroupId    String
  name             String
  institution      String?
  type             LiabilityType
  totalDebt        BigInt
  remainingBalance BigInt
  minimumPayment   BigInt        @default(0)
  interestRate     Decimal       @default(0) @db.Decimal(5, 2)
  dueDate          DateTime?
  notes            String?
  currency         String        @default("IDR")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  familyGroup      FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("liabilities")
}

model Insurance {
  id              String          @id @default(uuid())
  familyGroupId   String
  name            String          @db.VarChar(150)
  provider        String?         @db.VarChar(150)
  type            InsuranceType
  status          InsuranceStatus @default(aktif)
  coverageAmount  BigInt?
  premiumAmount   BigInt
  premiumPeriod   PremiumPeriod   @default(monthly)
  renewalDate     DateTime?
  policyNumber    String?         @db.VarChar(100)
  notes           String?         @db.VarChar(500)
  currency        String          @default("IDR") @db.VarChar(3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  familyGroup     FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("insurances")
}
