// EPIC-022 D2 — the only two investment-transaction kinds: adding to a
// position (buy, weighted-average cost) or reducing it (sell, realized P/L).
enum InvestmentTxType {
  buy
  sell
}

// Investasi rebuild (R2–R7) — what a ledger row IS. `kind` is the canonical
// classification; the older `type` column (InvestmentTxType) is kept as the
// legacy quantity direction (buy/opening → "buy", sell → "sell", null for
// income and corporate-action rows).
enum InvestmentTxKind {
  buy
  sell
  // Kepemilikan awal: a position the user already held. Never debits cash.
  opening
  dividend
  coupon
  interest
  corporate_action
}

// A voided row stays in the table (audit trail) but drops out of the replay.
enum InvestmentTxStatus {
  active
  void
}

