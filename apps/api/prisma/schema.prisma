generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

// EPIC-023 Task C (D1/D2/D3/D5) — three roles became six. `owner` / `member` /
// `admin_staff` are unchanged. `spouse` is a financial co-owner (full CRUD on
// every money surface, Member stays read-only, never `manage`). `dependant`
// (a child) and `operational` (a helper/driver) are ROW-scoped: CASL grants
// them "read"/"create" at the subject level (see CaslAbilityFactory), but
// every service read path additionally restricts them to rows they own or
// personally recorded — see common/utils/privacy.util.ts.
enum Role {
  owner
  member
  admin_staff
  spouse
  dependant
  operational
}

// EPIC-023 Task C (D1) — purely descriptive kinship, carries NO permission.
// `Member.role` is the only axis that grants authority; this enum only feeds
// the default-role mapping in `packages/contracts` (relationship pre-fills a
// role that stays fully editable — any (relationship, role) pair is valid).
enum MemberRelationship {
  istri
  anak
  kakek
  nenek
  bibi
  supir
  sekretaris
  bendahara
}

enum AccountType {
  bank
  ewallet
  cash
  investment
  property
}

enum CategoryKind {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum BudgetPeriod {
  monthly
  weekly
  yearly
}

enum GoalStatus {
  on_track
  needs_boost
  achieved
  at_risk
}

enum GoalContributionSource {
  manual
  auto
}

enum AssetType {
  properti
  kendaraan
  elektronik
  perhiasan
  lainnya
  emas
}

// EPIC-024 D2/US-ASSET-6: which linear projection Asset.valueChangeRatePct
// (percent) or Asset.valueChangeAmount (fixed) computeEstimatedValue applies.
enum AssetValueChangeMode {
  percent
  fixed
}

enum InvestmentType {
  saham
  reksa_dana
  obligasi
  emas
  kripto
  lainnya
  // EPIC-024 C2 (D10) — nominal, bunga %/thn, tanggal mulai + jatuh tempo,
  // valued by simple interest. Manual-priced (never reaches MarketDataPort).
  deposito
}

// EPIC-022 D2 — the only two investment-transaction kinds: adding to a
// position (buy, weighted-average cost) or reducing it (sell, realized P/L).
enum InvestmentTxType {
  buy
  sell
}

enum LiabilityType {
  kartu_kredit
  pinjaman_pribadi
  kpr
  kendaraan
  lainnya
}

enum InsuranceType {
  jiwa
  kesehatan
  kendaraan
  properti
  pendidikan
  lainnya
}

enum InsuranceStatus {
  aktif
  tidak_aktif
  kadaluarsa
}

enum PremiumPeriod {
  monthly
  quarterly
  yearly
}

enum SplitStatus {
  open
  settled
}

// EPIC-023 F3 (D21) — "claimed" is the "saya sudah transfer" state: the
// recipient says they sent the money but NO income has posted yet (Honest
// UI mandate — a claim is a claim, not a payment). Only the owner's
// confirm action (SplitBillsService.confirmParticipant) can move a
// participant into "paid", and that is the ONLY transition that ever posts
// a real Transaction / touches Account.balance.
enum ParticipantStatus {
  pending
  claimed
  paid
}

enum InheritanceVisibility {
  private
  heirs_only
  all_members
}

enum DonationType {
  zakat_maal
  zakat_fitrah
  infaq
  sedekah
  wakaf
  // EPIC-023 F2 (D20, US-DON-6/7) — the obligatory Christian contribution
  // (persepuluhan/tithe, collected by a recognised church body). PP 60/2010
  // widens tax-deductible "sumbangan keagamaan" beyond zakat to any
  // OBLIGATORY religious contribution for a recognised religion, which is
  // why excluding this type from `TAX_DEDUCTIBLE_DONATION_TYPES` was wrong.
  // A voluntary Christian offering still has no dedicated type and stays
  // recorded as `lainnya` (never deductible) — see donations.service.ts.
  persepuluhan
  lainnya
}

// EPIC-023 F2 (D20, US-DON-6/7) — a family-level setting, not a per-user
// one: the donation page (and its calculator) reflects the FAMILY's
// religion, matching `FamilyGroup.goldPricePerGram`'s precedent for a
// family-wide manual setting. `islam` is the default for every
// PRE-EXISTING family (see `FamilyGroup.religion` below) so this feature
// never changes what an existing family already saw (the donation page
// showed the zakat calculator unconditionally before this enum existed) —
// an owner can correct it immediately via PATCH .../religion.
enum FamilyReligion {
  islam
  kristen
  katolik
  hindu
  buddha
  none
}

enum SptStatus {
  belum_lapor
  sudah_lapor
  terlambat
}

enum ReconStatus {
  matched
  unmatched
  suggested
}

enum CoaDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum CoaBudgetType {
  FIXED
  VARIABLE
  REIMBURSEMENT
}

// EPIC-019 Task B — owner-approve funding request lifecycle.
enum AllowanceRequestStatus {
  pending
  approved
  rejected
}

// EPIC-023 G3 (D16) — bring-your-own AI provider. Provider-agnostic: a
// family picks exactly one at a time and supplies its own key.
// Only the two roles a stored transcript can contain. The provider adapters
// map this onto their own vocabulary ("model" for Gemini, "assistant"
// elsewhere); no system turn is persisted because the system prompt is rebuilt
// from live family data on every request, so storing a stale copy would let an
// old session answer from outdated figures.
enum AiMessageRole {
  user
  assistant
}

enum AiProvider {
  claude
  openai
  gemini
}

// EPIC-023 Task D (D3/D9) — what approving an AllowanceRequest DOES.
// `funding` (default — every pre-existing row): approval executes a
// TRANSFER (unchanged EPIC-019 Task B behavior). `held_expense`: a
// row-scoped member's over-threshold EXPENSE never posted; approval
// replays it as a real expense (see AllowanceRequest fields below and
// AllowanceRequestsService.approve).
enum AllowanceRequestKind {
  funding
  held_expense
}

// EPIC-024 Task J (D14, US-MD-1) — the seven reference lists that used to be
// hardcoded arrays in `masterdata/page.tsx` ("Master data is a client-side
// illusion" — Evidence). "Kategori" is intentionally excluded: it already has
// its own real table/API (Category) and stays that way.
enum ReferenceItemGroup {
  bank
  ewallet
  txntype
  invtype
  lembaga
  asettype
  instype
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id                       String             @id @default(uuid())
  email                    String             @unique
  name                     String
  emailVerified            Boolean            @default(false)
  image                    String?
  passwordHash             String?
  googleId                 String?            @unique
  // EPIC-023 D1/D6 (US-FAM-12, US-AUTH-9) — better-auth `username` plugin
  // fields (verified against the installed plugin's own schema export,
  // node_modules/.../better-auth/dist/plugins/username/schema.mjs: field
  // names `username`/`displayUsername`, both optional strings, `username`
  // unique). Populated only for head-created dependant/operational members
  // (FamilyGroupsService#createDependantMember); every pre-existing user
  // keeps both null and continues signing in by email as before.
  username                 String?            @unique
  displayUsername          String?
  // EPIC-031 — the family whose Master created this login (username and/or
  // email). Only that family's Master may reset its password; a user who
  // registered on their own has null here and recovers via email.
  managedByFamilyGroupId   String?
  // EPIC-031 — an email a Master entered for this member. It only becomes
  // `email` (sign-in + Lupa Password) once its owner clicks the confirmation
  // link, so a Master can never bind someone else's address without consent.
  // The token is stored hashed (sha256), single use, 7-day expiry.
  pendingEmail             String?
  pendingEmailTokenHash    String?            @unique
  pendingEmailExpiresAt    DateTime?
  managedByFamilyGroup     FamilyGroup?       @relation("ManagedUsers", fields: [managedByFamilyGroupId], references: [id], onDelete: SetNull)
  // EPIC-023 D1/D6 — true only for an account this endpoint just created;
  // ForcePasswordChangeGuard refuses every request except a small allowlist
  // until PasswordPolicyService#setPassword clears it back to false.
  mustChangePassword       Boolean            @default(false)
  avatarInitials           String?
  phone                    String?
  // birthDate/monthlyIncome are stored ciphertext (AES-256-GCM via CryptoService),
  // so they are String columns even though the values they represent are a date
  // and a number — see accounts.service.ts's Account.maskedNumber for the pattern.
  birthDate                String?
  gender                   String?
  jobTitle                 String?
  monthlyIncome            String?
  // Display currency preference (ISO 4217 code) — not sensitive, stored
  // plaintext unlike birthDate/monthlyIncome. Conversion rates come from the
  // mock FxPort, so any non-IDR display is always labeled indicative in the UI.
  currency                 String             @default("IDR") @db.VarChar(3)
  // Per-user notification toggles (EPIC-016 B3). Nullable JSON map of the 8
  // known keys → boolean; null = never set → use defaults. Stored sanitized by
  // resolveNotifPrefs. In-app Notification rows are family-scoped, so
  // enforcement reads the family OWNER's prefs (see notification-prefs.ts).
  notificationPrefs        Json?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  memberships              Member[]
  sessions                 BaSession[]
  baAccounts               BaAccount[]
  // EPIC-019 Task A — accounts this user personally owns within a family
  // group (nullable Account.ownerUserId; null = family-shared, unchanged).
  ownedAccounts            Account[]          @relation("AccountOwner")
  // EPIC-019 Task B — allowance requests this user filed / decided.
  allowanceRequestsMade    AllowanceRequest[] @relation("AllowanceRequestRequester")
  allowanceRequestsDecided AllowanceRequest[] @relation("AllowanceRequestDecider")
  // EPIC-023 Task C — transactions this user personally recorded (nullable;
  // never backfilled — see Transaction.createdByUserId).
  createdTransactions      Transaction[]      @relation("TransactionCreatedBy")
  // EPIC-023 D2 (US-FAM-13, D7) — devices this user has registered for PIN
  // unlock. A PIN alone never authenticates; see Device below.
  devices                  Device[]
  // This user's own saved AI advisor sessions, never another member's.
  aiConversations          AiConversation[]
  // Notifications addressed to this user specifically (household-wide ones
  // carry a null userId and belong to no one) — see Notification.userId.
  notifications            Notification[]
  notificationReads        NotificationRead[]

  @@map("users")
}

// EPIC-023 D2 (US-FAM-13, D7) — "PIN is a device unlock, not a credential."
// A row is created only from an ALREADY-authenticated session (right after a
// real password login) — see DevicesService#registerDevice. The device is
// identified by possession of `deviceSecret` (32+ random bytes generated
// client-side, never sent again after registration in any other form, hashed
// here with the same argon2 config used everywhere else in this codebase).
// `pinHash` stays null until the user opts in to setting a PIN; a device that
// never sets one simply keeps using password login every time (D7's "a new
// device needs the password again" fallback). `failedPinAttempts`/
// `lockedUntil` implement the 5-attempts/15-minute lockout in
// DevicesService#unlock — the fallback is always a real password login,
// which this lockout never affects.
model Device {
  id                String    @id @default(uuid())
  userId            String
  deviceSecretHash  String
  pinHash           String?
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  label             String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model BaSession {
  id            String   @id @default(uuid())
  expiresAt     DateTime
  token         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ipAddress     String?
  userAgent     String?
  userId        String
  familyGroupId String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model BaAccount {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model FamilyGroup {
  id                      String                   @id @default(uuid())
  name                    String
  // EPIC-031 — "kode keluarga": members the Master creates sign in as
  // `<username>@<handle>` (User.username holds the full ID). Unique app-wide,
  // no dots (so a login ID never looks like an email). Nullable only so the
  // column could be added; every family is backfilled / lazily assigned.
  handle                  String?                  @unique
  managedUsers            User[]                   @relation("ManagedUsers")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 Member[]
  accessRoles             AccessRole[]
  accounts                Account[]
  categories              Category[]
  transactions            Transaction[]
  budgets                 Budget[]
  goals                   Goal[]
  notifications           Notification[]
  assets                  Asset[]
  investments             Investment[]
  liabilities             Liability[]
  insurances              Insurance[]
  invitations             Invitation[]
  splitBills              SplitBill[]
  inheritanceAssets       InheritanceAsset[]
  donations               Donation[]
  taxRecords              TaxRecord[]
  bankSyncs               BankSync[]
  netWorthSnapshots       NetWorthSnapshot[]
  coaAccounts             CoaAccount[]
  // EPIC-019 Task B — member-request -> owner-approve funding requests.
  allowanceRequests       AllowanceRequest[]
  // EPIC-021 Group F (#6) — user-maintained gold price per gram (IDR),
  // manually entered by the family owner via PATCH .../gold-price. No live
  // gold price feed exists or may be fabricated (Open Design Decision #6),
  // so this is nullable: the consolidated total shows an honest "set your
  // gold price" prompt until an owner sets one, and every display of it is
  // labeled "diinput manual, per <date>" using goldPriceUpdatedAt.
  goldPricePerGram        BigInt?
  goldPriceUpdatedAt      DateTime?
  // EPIC-023 F2 (D20, US-DON-6/7) — family religion setting driving which
  // donation calculator (zakat vs. perpuluhan vs. neither) the donation
  // page shows, and widening tax-deductibility per PP 60/2010 beyond zakat
  // to obligatory religious contributions of other recognised religions.
  // EPIC-023 Group F fix round (MEDIUM 9) — nullable, no default: F2's
  // original `@default(islam)` asserted a faith on every pre-existing
  // family with no way to tell "explicitly chosen" from "never touched".
  // `null` is now its own honest state ("not yet chosen" — see
  // useFamilyReligion.ts / DonationPage), distinct from the three real
  // choices in the enum. See migration 20260806170000 for how existing
  // families are treated.
  religion                FamilyReligion?
  // EPIC-023 G2 (D17) — per-bank saved column-mapping templates, so a
  // returning statement imports without remapping columns each time.
  reconciliationTemplates ReconciliationTemplate[]
  // EPIC-023 G3 (D16) — bring-your-own AI provider key. One active key per
  // family (nullable relation); the key itself is never stored plaintext
  // (see FamilyAiKey.encryptedKey).
  aiKey                   FamilyAiKey?
  // Saved advisor sessions for this family (per-member — see AiConversation).
  aiConversations         AiConversation[]
  // EPIC-024 Task J (D14, US-MD-1) — the seven reference-list groups (bank,
  // e-wallet, transaction type, investment type, donation institution, asset
  // category, insurance type).
  referenceItems          ReferenceItem[]
  // EPIC-024 Task L2 — denormalized tenant scope on TransactionAttachment
  // (see that model's comment for why).
  transactionAttachments  TransactionAttachment[]
  goalContributions       GoalContribution[]

  @@map("family_groups")
}

model CoaAccount {
  id            String         @id @default(uuid())
  familyGroupId String
  code          String
  name          String
  // groupNum taxonomy (EPIC-017 Decision #3 — a personal-finance chart, NOT the
  // classic Asset/Liability/Equity set):
  //   1 Income · 2 Expense · 3 Wealth Allocation · 4 Receivable · 5 Payable · 6 Tax
  groupNum      Int
  direction     CoaDirection
  budgetType    CoaBudgetType?
  parentCode    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  familyGroup   FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  categories    Category[]

  @@unique([familyGroupId, code])
  @@index([familyGroupId])
  @@map("coa_accounts")
}

model Invitation {
  id            String              @id @default(uuid())
  token         String              @unique @default(uuid())
  familyGroupId String
  email         String
  role          Role                @default(member)
  // EPIC-023 Task C (D1) — optional kinship carried from invite to
  // acceptance, for the roles that still arrive by email (spouse, bookkeeper
  // — D6). Purely descriptive; does not constrain `role` above.
  relationship  MemberRelationship?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime            @default(now())
  familyGroup   FamilyGroup         @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@index([email])
  @@map("invitations")
}

model Member {
  id                 String                    @id @default(uuid())
  userId             String
  familyGroupId      String
  role               Role
  // EPIC-023 Task C (D1) — nullable kinship descriptor; every pre-existing
  // member stays valid with `relationship = null`. See MemberRelationship.
  relationship       MemberRelationship?
  // EPIC-023 Task D (D3/D9, US-FAM-14) — per-member large-transaction
  // threshold, IDR minor units. `null` (every pre-existing member,
  // backward compatible) = no gate: this member's expenses are never held.
  // A non-null value only ever gates a ROW-SCOPED role (dependant/
  // operational, see isRowScopedRole in common/utils/privacy.util.ts) — an
  // expense that STRICTLY EXCEEDS this amount is held pending the head's
  // approval instead of posting immediately (see
  // TransactionsService.create / AllowanceRequest.kind = held_expense
  // below). Trusted roles (owner/spouse/admin_staff/member) are never held
  // even if a threshold happens to be set on their row — D9 only gates
  // row-scoped roles; a threshold on a trusted role's own row only ever
  // adjusts THEIR "large transaction" notification cutoff (see
  // TransactionsService.notifyTransaction), never a hold.
  largeTxnThreshold  BigInt?
  // EPIC-027 A7 (D4) — soft delete. Removing a member used to hard-delete this
  // row while leaving the User + credential intact, so a removed child kept
  // signing in by username and, with no membership left, was treated as a
  // trusted role by the web shell. The row now survives with `deletedAt` set:
  // access is gone (every read is filtered by the Prisma extension in
  // prisma/member-soft-delete.extension.ts), history is intact, and the head
  // can restore the member from /iam.
  //
  // NOTE the `@@unique([userId, familyGroupId])` below still counts a
  // soft-deleted row. That is deliberate: the same user cannot be re-added to
  // the same family as a duplicate row — they are restored instead.
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyGroup        FamilyGroup               @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  // EPIC-019 Task C — per-member allowed expense categories. Empty (no
  // rows) = unrestricted, backward compatible with every pre-existing member.
  categoryAllowances MemberCategoryAllowance[]
  // EPIC-030 — IAM. `accessRoleId` null = no custom role: the built-in
  // `role`'s legacy preset applies (@wealthme/contracts LEGACY_ACCESS_PRESETS),
  // so pre-existing members keep exactly their old access. `accessOverrides`
  // is a sparse page → level map applied on top of the role. Ignored for
  // `owner` (Master always has full access).
  accessRoleId       String?
  accessRole         AccessRole?               @relation(fields: [accessRoleId], references: [id], onDelete: SetNull)
  accessOverrides    Json?

  @@unique([userId, familyGroupId])
  @@index([familyGroupId])
  // EPIC-027 A7 — every read now carries `deletedAt: null` alongside the
  // family filter; the familyGroupId-only index would still scan removed rows.
  @@index([familyGroupId, deletedAt])
  @@map("members")
}

model Account {
  id                        String             @id @default(uuid())
  familyGroupId             String
  name                      String
  type                      AccountType
  institution               String?
  maskedNumber              String?
  balance                   BigInt
  currency                  String             @default("IDR")
  // Owner-set flag: hides this account (and its transactions transitively)
  // from `member` viewers in shared family views. Owner/admin_staff always see it.
  isPrivate                 Boolean            @default(false)
  // EPIC-019 Task A — nullable per-member ownership. Null = family-shared
  // (today's behavior, unchanged); non-null must reference a Member of the
  // SAME familyGroupId (enforced in AccountsService, not the DB, since a
  // cross-tenant check needs the Member row, not just the User row).
  // onDelete: SetNull so removing the owning user never destroys the account
  // itself — it just reverts to family-shared.
  ownerUserId               String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  familyGroup               FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  owner                     User?              @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Two relations to Transaction (source leg + transfer destination leg —
  // EPIC-021 Group B / #23/#27/#28) require explicit relation names so Prisma
  // can disambiguate which FK each list represents.
  transactions              Transaction[]      @relation("TransactionSourceAccount")
  transfersIn               Transaction[]      @relation("TransactionDestinationAccount")
  // EPIC-019 Task B — this account as the target (member's account being
  // funded) or the chosen source (owner's master account) of a funding
  // request. Explicit relation names to disambiguate the two FKs.
  allowanceRequestsAsTarget AllowanceRequest[] @relation("AllowanceRequestTarget")
  allowanceRequestsAsSource AllowanceRequest[] @relation("AllowanceRequestSource")
  goalsAsSource             Goal[]
  goalContributions         GoalContribution[]

  @@unique([familyGroupId, name])
  @@index([familyGroupId])
  @@index([ownerUserId])
  @@map("accounts")
}

model Category {
  id                             String                    @id @default(uuid())
  familyGroupId                  String
  name                           String
  kind                           CategoryKind
  color                          String?
  icon                           String?
  // Owner-set flag: hides this category (and its transactions transitively)
  // from `member` viewers in shared family views. Owner/admin_staff always see it.
  isPrivate                      Boolean                   @default(false)
  // Mandatory COA link (EPIC-017 Decision #2). Every category maps to a
  // CoaAccount in the SAME family group; reports classify transitively via
  // Transaction → Category → CoaAccount (direction + groupNum). Restrict so a
  // COA account in use by a category cannot be deleted out from under it.
  coaAccountId                   String
  createdAt                      DateTime                  @default(now())
  familyGroup                    FamilyGroup               @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  coaAccount                     CoaAccount                @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  transactions                   Transaction[]
  budgets                        Budget[]
  // EPIC-019 Task C — members whose allow-list includes this category.
  memberAllowances               MemberCategoryAllowance[]
  // EPIC-021 #16: physical-asset "master data" category. Reuses this model
  // (the only master-data entity with a real API) instead of a new table.
  assets                         Asset[]
  // EPIC-023 Task D (D3/D9) — a held_expense AllowanceRequest's captured
  // category (null for a funding request).
  allowanceRequests              AllowanceRequest[]
  // EPIC-023 group E retry (HIGH 4) — back-relations for the per-obligation
  // principal/premium category (see Liability.principalCategoryId /
  // Insurance.premiumCategoryId). Always 0-or-1 in practice (each is this
  // category's OWN obligation), plural only because Prisma relation fields
  // on the "one" side of a 1-n are always lists.
  liabilitiesAsPrincipalCategory Liability[]               @relation("LiabilityPrincipalCategory")
  insurancesAsPremiumCategory    Insurance[]               @relation("InsurancePremiumCategory")

  @@unique([familyGroupId, name, kind])
  @@index([familyGroupId])
  @@index([coaAccountId])
  @@map("categories")
}

// EPIC-024 Task J (D14, US-MD-1) — real, per-family-group master data for the
// seven reference lists (bank, e-wallet, transaction type, investment type,
// donation institution, asset category, insurance type). Seeded from
// `REFERENCE_ITEM_DEFAULTS` (`@wealthme/contracts`) at registration
// (`isSystem: true`); an owner/spouse can add more (`isSystem: false`).
// Seeded rows are protected from deletion — see ReferenceItemsService.remove.
model ReferenceItem {
  id            String             @id @default(uuid())
  familyGroupId String
  group         ReferenceItemGroup
  label         String
  sortOrder     Int                @default(0)
  isSystem      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  familyGroup   FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, group, label])
  @@index([familyGroupId, group])
  @@map("reference_items")
}

model Transaction {
  id               String                  @id @default(uuid())
  familyGroupId    String
  // EPIC-023 E3 (D12, US-LIAB-5) — nullable so a credit-card purchase can
  // touch NO bank/cash account at all: it debits nothing here and instead
  // raises `Liability.remainingBalance`/`totalDebt` via `liabilityId` below
  // (see LiabilitiesService.purchase()). Every other transaction (income/
  // expense/transfer created through TransactionsService.create()) keeps a
  // required, non-null accountId — unchanged.
  accountId        String?
  // Nullable destination account (EPIC-021 Group B / EPIC-019 Decision #1 —
  // single row + nullable toAccountId, NOT paired debit/credit legs). Only
  // meaningful when type = transfer; null on income/expense and on legacy
  // one-sided transfer rows created before this field existed. onDelete:
  // Restrict (not SetNull/Cascade) so an account that has ever been a
  // transfer destination cannot be deleted out from under its own history —
  // the source-side `account` FK below stays Cascade (unchanged, pre-existing
  // behavior) since that side already governs the row's lifecycle.
  toAccountId      String?
  categoryId       String?
  amount           BigInt
  type             TransactionType
  description      String?
  occurredAt       DateTime
  createdAt        DateTime                @default(now())
  // EPIC-023 Task C — who recorded this row, so a row-scoped role (dependant/
  // operational) can see "transactions they own or that they recorded" even
  // on a family-shared account. Nullable, NOT backfilled: every pre-existing
  // row stays null, which correctly means a newly row-scoped member sees
  // none of the pre-existing household ledger. onDelete: SetNull — a member
  // leaving the family (or the app) must never cascade-delete transaction
  // history; the row just loses its "recorded by" attribution.
  createdByUserId  String?
  // EPIC-023 E1 — links a payment transaction back to the obligation it
  // settles (D10, US-LIAB-4, US-INS-4): one ledger, one truth, instead of a
  // description string being the only trace of which liability/insurance a
  // transaction paid down. Both nullable — only payment-generated rows set
  // one of these; a normal income/expense/transfer leaves both null.
  // onDelete: SetNull so deleting the Liability/Insurance never cascades
  // into deleting transaction history, mirroring `category`/`createdBy`
  // above.
  liabilityId      String?
  insuranceId      String?
  familyGroup      FamilyGroup             @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  account          Account?                @relation("TransactionSourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount        Account?                @relation("TransactionDestinationAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category         Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy        User?                   @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  liability        Liability?              @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  insurance        Insurance?              @relation(fields: [insuranceId], references: [id], onDelete: SetNull)
  // EPIC-024 Task L (L2, D15, US-TXN-9) — receipts/photos attached to this
  // transaction, stored on server disk behind StoragePort.
  attachments      TransactionAttachment[]
  goalContribution GoalContribution?

  @@index([familyGroupId, occurredAt])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([liabilityId])
  @@index([insuranceId])
  @@map("transactions")
}

// EPIC-024 Task L2 (D15, US-TXN-9) — one row per uploaded attachment.
// `path` is the storage KEY returned by StoragePort.upload() (a
// server-generated UUID-based key — see StorageDiskService — NEVER the
// client-supplied filename, to rule out path traversal). `familyGroupId` is
// denormalized alongside `transactionId` so every read/delete can be scoped
// to the caller's tenant in a single indexed WHERE clause without an extra
// join, and so a row can never "belong" to a transaction outside its own
// family even if `transactionId` were guessed.
model TransactionAttachment {
  id            String      @id @default(uuid())
  transactionId String
  familyGroupId String
  path          String
  mimeType      String
  size          Int
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([transactionId, familyGroupId])
  @@index([familyGroupId])
  @@map("transaction_attachments")
}

// EPIC-019 Task B — member-requests -> owner-approves funding. Approval
// executes a REAL transfer via the existing EPIC-021 Group B transfer
// primitive (TransactionsService.create with type "transfer"): the owner's
// chosen `fromAccount` debits, the member's `targetAccount` credits,
// atomically. This row is the request/decision audit trail, not the money
// movement itself — the money movement is a normal Transaction row.
//
// EPIC-023 Task D (D3/D9) extends this SAME primitive to a second `kind`,
// `held_expense`: a row-scoped member's over-threshold EXPENSE attempt,
// captured here instead of posting, replayed as a real expense on
// approval (AllowanceRequestsService.approve). Field meaning by `kind`:
//   - `targetAccountId` — funding: the requester's account to be FUNDED.
//                         held_expense: the account the deferred expense
//                         would DEBIT (repurposed, not a new column, to
//                         keep this one small primitive; the name reads
//                         oddly for held_expense but is documented here).
//   - `fromAccountId`   — funding only: the owner-chosen source account at
//                         approval time. Always null for held_expense (no
//                         second account is ever involved in an expense).
//   - `categoryId`      — held_expense only: the expense's category (may
//                         be null, same as Transaction.categoryId).
//                         Always null for funding.
//   - `description`     — held_expense only: the expense's free-text
//                         description. Always null for funding.
//   - `note`            — funding only: the requester's optional note.
model AllowanceRequest {
  id              String                 @id @default(uuid())
  familyGroupId   String
  requesterUserId String
  targetAccountId String
  // Chosen by the OWNER at approval time, not by the requester — nullable
  // until decided.
  fromAccountId   String?
  amount          BigInt
  note            String?
  kind            AllowanceRequestKind   @default(funding)
  categoryId      String?
  description     String?
  status          AllowanceRequestStatus @default(pending)
  createdAt       DateTime               @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  familyGroup     FamilyGroup            @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  requester       User                   @relation("AllowanceRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  targetAccount   Account                @relation("AllowanceRequestTarget", fields: [targetAccountId], references: [id], onDelete: Cascade)
  fromAccount     Account?               @relation("AllowanceRequestSource", fields: [fromAccountId], references: [id], onDelete: SetNull)
  category        Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  decidedByUser   User?                  @relation("AllowanceRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([familyGroupId, status])
  @@index([requesterUserId])
  @@index([categoryId])
  @@map("allowance_requests")
}

// EPIC-019 Task C — per-member allow-list join table (Decision #3a). A
// member with zero rows is unrestricted (backward compatible with every
// pre-existing member); a member with any row is constrained to spend only
// in the listed expense categories, enforced server-side in
// TransactionsService.
model MemberCategoryAllowance {
  id         String   @id @default(uuid())
  memberId   String
  categoryId String
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([memberId, categoryId])
  @@index([memberId])
  @@map("member_category_allowances")
}

model Budget {
  id            String         @id @default(uuid())
  familyGroupId String
  categoryId    String
  period        BudgetPeriod
  limitAmount   BigInt
  // EPIC-033 group 5 — day of month (1-28) the auto-debit runs.
  autoDebitDay  Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // EPIC-023 E2 (D11) / group E retry (HIGH 4) — set on the FIXED budget
  // line auto-created when a Liability/Insurance is added; a normal
  // user-made budget leaves both null. Since EPIC-023 group E retry, EVERY
  // liability/insurance gets its OWN Category (Liability.
  // principalCategoryId / Insurance.premiumCategoryId), so this Budget row
  // is EXCLUSIVE to the one obligation that seeded it — never shared with
  // a sibling obligation the way it used to be (a family's liabilities/
  // insurances no longer collapse onto one shared category+budget line).
  // `remove()` deletes this row when the obligation it belongs to is
  // deleted (see `LiabilitiesService`/`InsurancesService`); onDelete:
  // Restrict on the FK below is defence-in-depth for a bug in that
  // ordering, not the primary mechanism.
  liabilityId   String?
  insuranceId   String?
  // EPIC-023 group E retry round 3 (MEDIUM 12) — set directly by
  // `LiabilitiesService`/`InsurancesService` when they auto-create this
  // obligation's own budget line, instead of the old `markCategoryFixed`
  // which mutated the category's SHARED `CoaAccount.budgetType` and
  // silently reclassified every OTHER category on that account too. Null
  // for a normal user-made budget — `BudgetsService.toDto` falls back to
  // `category.coaAccount.budgetType` in that case.
  budgetType    CoaBudgetType?
  familyGroup   FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  liability     Liability?     @relation(fields: [liabilityId], references: [id], onDelete: Restrict)
  insurance     Insurance?     @relation(fields: [insuranceId], references: [id], onDelete: Restrict)

  @@unique([familyGroupId, categoryId, period])
  @@index([familyGroupId])
  @@index([liabilityId])
  @@index([insuranceId])
  @@map("budgets")
}

model Goal {
  id              String             @id @default(uuid())
  familyGroupId   String
  name            String
  icon            String?
  targetAmount    BigInt
  currentAmount   BigInt             @default(0)
  targetDate      DateTime?
  autoDebitAmount BigInt?
  // EPIC-033 group 5 — day of month (1-28) the auto-debit runs.
  autoDebitDay    Int?
  // Revisi F — account the daily auto-debit draws from.
  sourceAccountId String?
  lastAutoDebitAt DateTime?
  status          GoalStatus         @default(on_track)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  familyGroup     FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  sourceAccount   Account?           @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  contributions   GoalContribution[]

  @@index([familyGroupId])
  @@index([sourceAccountId])
  @@map("goals")
}

// Revisi F — a payment into a goal; transactionId is set only when money left an account.
model GoalContribution {
  id            String                 @id @default(uuid())
  familyGroupId String
  goalId        String
  amount        BigInt
  accountId     String?
  transactionId String?                @unique
  occurredAt    DateTime
  source        GoalContributionSource @default(manual)
  createdAt     DateTime               @default(now())
  familyGroup   FamilyGroup            @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  goal          Goal                   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account       Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction   Transaction?           @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([familyGroupId, goalId, occurredAt])
  @@index([accountId])
  @@map("goal_contributions")
}

model Notification {
  id            String             @id @default(uuid())
  familyGroupId String
  // Recipient. `null` = addressed to the household (budget thresholds, goal
  // progress, due-date reminders — everything that is genuinely everyone's
  // business, and every row that existed before this column).
  //
  // Set = addressed to ONE member. This column is why it exists: a funding
  // request's approve/reject notification is news for the person who asked,
  // and `notifyRequesterOfDecision` used to create a family-wide row that
  // the requester could not read at all — `dependant`/`operational`, the
  // only roles that ever request funds, have no CASL grant on Notification,
  // so the decision landed exclusively in the owner's list. Meanwhile every
  // trusted member saw "Bibi May meminta Rp 100000", which is not their
  // business either.
  //
  // Row-scoped roles are shown ONLY their own targeted rows — never the
  // `null` household ones, which carry the whole-family figures
  // `assertHouseholdWideReadAllowed` denies them everywhere else.
  userId        String?
  title         String
  body          String
  icon          String?
  // DEPRECATED — the old single shared flag (one member marking a household
  // row read hid it for everyone). Read state is per member now, in
  // NotificationRead; this column is kept only so the change is additive and
  // is no longer read or written by the API.
  isRead        Boolean            @default(false)
  reads         NotificationRead[]
  createdAt     DateTime           @default(now())
  familyGroup   FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  // Serves the only list query there is: household rows plus this viewer's
  // own, newest first.
  @@index([familyGroupId, userId, createdAt])
  @@map("notifications")
}

/// Who has read a notification — one row per (notification, member), so a
/// household notification is read or unread for each member separately.
model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

model Asset {
  id                 String               @id @default(uuid())
  familyGroupId      String
  name               String
  type               AssetType
  currentValue       BigInt
  currency           String               @default("IDR")
  notes              String?
  // EPIC-021 #17/#18 (Open Design Decision #8): ONE signed annual
  // value-change rate per asset — negative = depreciation, positive =
  // appreciation. Compute-on-read (see AssetsService); a snapshot still
  // lands in AssetHistory whenever currentValue itself is edited.
  valueChangeRatePct Decimal?             @db.Decimal(5, 2)
  // EPIC-024 D2/US-ASSET-6: which linear projection computeEstimatedValue
  // applies — "percent" reads valueChangeRatePct (existing behavior,
  // default so every pre-existing row keeps its current projection
  // unchanged), "fixed" reads valueChangeAmount below (a flat signed Rp/yr
  // delta instead of a rate). Additive: DEFAULT keeps this NOT NULL without
  // a backfill script.
  valueChangeMode    AssetValueChangeMode @default(percent)
  // EPIC-024 D2/US-ASSET-6: signed Rp/year delta used only when
  // valueChangeMode is "fixed" (negative = depreciation, positive =
  // appreciation — same sign convention as valueChangeRatePct). Linear,
  // floored at 0 by computeEstimatedValue, never applied when mode is
  // "percent".
  valueChangeAmount  BigInt?
  // EPIC-023 D19/US-ASSET-4: optional date the asset was acquired, used as
  // the elapsed-time anchor for computeEstimatedValue's projection instead
  // of createdAt. Nullable and additive — existing rows keep falling back to
  // createdAt (AssetsService#toAssetDto), so no backfill is required.
  acquisitionDate    DateTime?            @db.Date
  // EPIC-021 #16: optional physical-asset category sourced from master data.
  // Reuses the existing Category model (masterdata's only real API) instead
  // of a new table; the hardcoded `type` enum above remains as a fallback
  // display value when no category is set.
  categoryId         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  familyGroup        FamilyGroup          @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  history            AssetHistory[]
  attachments        AssetAttachment[]

  @@index([familyGroupId])
  @@index([categoryId])
  @@map("assets")
}

// EPIC-033 p14 — documents attached to a physical asset (sertifikat, BPKB,
// polis). Same storage contract as TransactionAttachment.
model AssetAttachment {
  id            String   @id @default(uuid())
  assetId       String
  familyGroupId String
  path          String
  mimeType      String
  size          Int
  createdAt     DateTime @default(now())
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, familyGroupId])
  @@map("asset_attachments")
}

model AssetHistory {
  id               String   @id @default(uuid())
  assetId          String
  value            BigInt
  recordedAt       DateTime @default(now())
  // EPIC-033 group 3 — who entered this value (null for system writes) and
  // an optional note ("harga taksiran notaris", etc.).
  recordedByUserId String?
  note             String?
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt])
  @@map("asset_history")
}

model NetWorthSnapshot {
  id               String      @id @default(uuid())
  familyGroupId    String
  capturedAt       DateTime    @default(now())
  // Calendar day the snapshot represents (distinct from the precise
  // `capturedAt` timestamp). Unique per family group so the writer can
  // upsert instead of check-then-insert, closing the double-write race.
  date             DateTime    @db.Date
  totalCash        BigInt
  totalInvestments BigInt
  totalAssets      BigInt
  totalLiabilities BigInt
  netWorth         BigInt
  familyGroup      FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, date])
  @@index([familyGroupId, capturedAt])
  @@map("net_worth_snapshots")
}

model Investment {
  id               String                  @id @default(uuid())
  familyGroupId    String
  ticker           String
  name             String
  type             InvestmentType
  quantity         Decimal                 @db.Decimal(18, 8)
  costBasisPerUnit Decimal                 @db.Decimal(18, 2)
  currency         String                  @default("IDR")
  notes            String?
  // EPIC-021 #20: interest rate for interest-bearing instruments (obligasi,
  // deposito). Optional — only meaningful for those types. Used to derive a
  // simple projected-annual-yield display (currentValue × rate).
  interestRatePct  Decimal?                @db.Decimal(5, 2)
  // EPIC-024 C2 (D7, D10) — "tanggal beli" for every type; deposito's
  // "jatuh tempo". Both nullable/additive: existing rows keep working, the
  // simple-interest valuation (investasi/page.tsx) treats a missing
  // purchasedAt as "not yet dated" rather than guessing a date.
  purchasedAt      DateTime?
  maturityDate     DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  familyGroup      FamilyGroup             @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  prices           InvestmentPrice[]
  // EPIC-022 D2 — real buy/sell history, the honest counterpart to the
  // generic "edit" that used to silently overwrite quantity/costBasisPerUnit
  // with no trace of what changed or any realized P/L.
  transactions     InvestmentTransaction[]

  @@index([familyGroupId])
  @@map("investments")
}

// EPIC-022 D2 — one buy or sell event against an Investment. `quantity` and
// `pricePerUnit` are the transaction's own terms (never the holding's
// post-transaction state); `realizedPnl` is set ONLY for a sell
// ((pricePerUnit - costBasisPerUnit at the time of sale) × quantity) and is
// always null for a buy. Additive/append-only: nothing here is ever
// mutated or deleted by later transactions — this table IS the history the
// old whole-record "edit" destroyed.
model InvestmentTransaction {
  id           String           @id @default(uuid())
  investmentId String
  type         InvestmentTxType
  quantity     Decimal          @db.Decimal(18, 8)
  pricePerUnit Decimal          @db.Decimal(18, 2)
  occurredAt   DateTime
  realizedPnl  Decimal?         @db.Decimal(18, 2)
  createdAt    DateTime         @default(now())
  // HIGH (EPIC-022 D2 retry) — `onDelete: Cascade` here is safe ONLY
  // because `InvestmentsService.remove()` refuses to delete an Investment
  // while any InvestmentTransaction row references it (mirrors
  // `LiabilitiesService.remove()`'s budget-line guard). If that
  // service-level guard is ever removed, this FK will silently cascade-
  // delete a holding's entire realized buy/sell/P-L history — do not trust
  // this comment over the actual state of `InvestmentsService.remove()`.
  investment   Investment       @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, occurredAt])
  @@map("investment_transactions")
}

model InvestmentPrice {
  id           String     @id @default(uuid())
  investmentId String
  price        Decimal    @db.Decimal(18, 2)
  source       String     @default("mock")
  // EPIC-023 G1 (D15) — `asOf` is the provider's own quote timestamp (may
  // predate `recordedAt`, e.g. Yahoo's delayed IDX feed); null on legacy rows
  // written before this column existed, where `recordedAt` is the best
  // available estimate. `delayed` is true only for feeds the honesty bar
  // requires labelling as delayed/unofficial (Yahoo `.JK`); false for
  // near-real-time feeds (CoinGecko) and manual entries.
  asOf         DateTime?
  delayed      Boolean    @default(false)
  recordedAt   DateTime   @default(now())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, recordedAt])
  @@map("investment_prices")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  familyGroupId String?
  action        String
  entity        String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([familyGroupId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Liability {
  id                  String        @id @default(uuid())
  familyGroupId       String
  name                String
  institution         String?
  type                LiabilityType
  totalDebt           BigInt
  remainingBalance    BigInt
  minimumPayment      BigInt        @default(0)
  interestRate        Decimal       @default(0) @db.Decimal(5, 2)
  dueDate             DateTime?
  autoAdvanceDueDate  Boolean       @default(false)
  notes               String?
  currency            String        @default("IDR")
  // EPIC-023 group E retry (HIGH 4) — this liability's OWN principal
  // Category, self-healed (created) the first time it needs a budget line
  // or a payment. Every liability gets its own category (instead of every
  // liability in a family sharing ONE category) so `Budget.liabilityId` is
  // exclusive per obligation — see `Budget`'s doc comment. Nullable: a
  // liability with minimumPayment: 0 that has never been paid has no
  // category yet. onDelete: SetNull — a Category deleted through the
  // Categories API (unusual, but not blocked by this FK) must not cascade
  // into deleting the Liability itself.
  principalCategoryId String?
  principalCategory   Category?     @relation("LiabilityPrincipalCategory", fields: [principalCategoryId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  familyGroup         FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  // EPIC-023 E1 — the payment transactions posted against this liability
  // (see Transaction.liabilityId above).
  transactions        Transaction[]
  // EPIC-023 E2 — the FIXED budget line auto-created for this liability
  // (see Budget.liabilityId above). Restrict-guarded: deleting a liability
  // while a budget line still references it is refused in the app layer.
  budgets             Budget[]

  @@index([familyGroupId])
  @@index([principalCategoryId])
  @@map("liabilities")
}

model Insurance {
  id                String                 @id @default(uuid())
  familyGroupId     String
  name              String                 @db.VarChar(150)
  provider          String?                @db.VarChar(150)
  type              InsuranceType
  status            InsuranceStatus        @default(aktif)
  coverageAmount    BigInt?
  premiumAmount     BigInt
  premiumPeriod     PremiumPeriod          @default(monthly)
  renewalDate       DateTime?
  autoRenewDate     Boolean                @default(false)
  policyNumber      String?                @db.VarChar(100)
  notes             String?                @db.VarChar(500)
  currency          String                 @default("IDR") @db.VarChar(3)
  // EPIC-023 group E retry (HIGH 4) — this policy's OWN premium Category,
  // mirroring Liability.principalCategoryId above (see that field's doc
  // comment for the full reasoning).
  premiumCategoryId String?
  premiumCategory   Category?              @relation("InsurancePremiumCategory", fields: [premiumCategoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  familyGroup       FamilyGroup            @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  beneficiaries     InsuranceBeneficiary[]
  // EPIC-023 E1 — the premium payment transactions posted against this
  // policy (see Transaction.insuranceId above).
  transactions      Transaction[]
  // EPIC-023 E2 — the FIXED budget line auto-created for this policy (see
  // Budget.insuranceId above). Restrict-guarded: deleting a policy while a
  // budget line still references it is refused in the app layer.
  budgets           Budget[]

  @@index([familyGroupId])
  @@index([premiumCategoryId])
  @@map("insurances")
}

// EPIC-021 Group D (#14) — insurance policy beneficiaries, sharing the same
// shape as InheritanceHeir (decision: warisan + asuransi use one beneficiary
// shape) — free-text name/relationship plus an optional link to a
// family-group member (`memberUserId` -> User.id, unenforced FK like
// Donation.accountId elsewhere in this schema).
model InsuranceBeneficiary {
  id           String    @id @default(uuid())
  insuranceId  String
  name         String    @db.VarChar(100)
  relationship String    @db.VarChar(100)
  sharePercent Decimal   @db.Decimal(5, 2)
  memberUserId String?
  createdAt    DateTime  @default(now())
  insurance    Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)

  @@index([insuranceId])
  @@map("insurance_beneficiaries")
}

model SplitBill {
  id                 String             @id @default(uuid())
  familyGroupId      String
  title              String             @db.VarChar(200)
  totalAmount        BigInt
  currency           String             @default("IDR") @db.VarChar(3)
  status             SplitStatus        @default(open)
  notes              String?
  // EPIC-023 F3 (D21) — the account the owner nominates to receive
  // transfers for this bill: rendered on every recipient's own share link
  // ("how to pay") AND credited for real once the owner confirms a
  // participant's claim (SplitBillsService.confirmParticipant). Unenforced
  // FK — same convention as `Donation.accountId` elsewhere in this schema
  // (no Prisma relation, validated against the same familyGroupId in the
  // service layer) — nullable so it never blocks pre-F3 rows; NEW bills
  // are required to set one at the DTO layer (CreateSplitBillDto).
  payoutAccountId    String?
  // Free-text fallback shown alongside the account's own name/institution/
  // maskedNumber — e.g. an e-wallet number that isn't modeled as an
  // Account row in this app.
  payoutInstructions String?            @db.VarChar(300)
  // "Revocable" (D21): the owner can kill every participant's share link
  // for this bill at once without deleting the bill itself. Both public
  // endpoints check this and answer with an honest 410 Gone, never a bare
  // 404 that could be confused with "this token never existed".
  revokedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  familyGroup        FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  participants       SplitParticipant[]

  @@index([familyGroupId])
  @@map("split_bills")
}

model SplitParticipant {
  id                      String            @id @default(uuid())
  splitBillId             String
  name                    String            @db.VarChar(100)
  amountOwed              BigInt
  status                  ParticipantStatus @default(pending)
  // EPIC-023 F3 (D21) — this participant's OWN unguessable link identifier,
  // replacing the old bill-wide `SplitBill.shareToken` (dropped in the same
  // migration). A bill-wide token cannot distinguish which recipient is
  // asking, so the public share page and its API (getPublicParticipant /
  // claimParticipant) key off THIS token and only ever return this one
  // participant's own share — never `familyGroupId`, never the siblings'
  // names/amounts. `@default(uuid())` — same CSPRNG-backed generator
  // (Node's `crypto.randomUUID()` under Prisma's `uuid()`) already used for
  // every other unguessable token in this schema (Invitation.token,
  // Device secrets); 122 bits of randomness is adequate here, so this does
  // NOT need a bespoke generator.
  shareToken              String            @unique @default(uuid())
  // Set when the recipient taps "saya sudah transfer" (claimParticipant).
  // Moves NO money — see the ParticipantStatus comment.
  claimedAt               DateTime?
  paidAt                  DateTime?
  // Unenforced FK (same convention as Donation.transactionId) to the real
  // Transaction that confirmParticipant() posted, once it exists. Lets a
  // second confirm() call on an already-"paid" participant recognize the
  // no-op case without re-deriving it from anything but this row.
  settlementTransactionId String?           @unique
  createdAt               DateTime          @default(now())
  splitBill               SplitBill         @relation(fields: [splitBillId], references: [id], onDelete: Cascade)

  @@index([splitBillId])
  @@map("split_participants")
}

model InheritanceAsset {
  id             String                @id @default(uuid())
  familyGroupId  String
  name           String                @db.VarChar(200)
  assetType      String                @db.VarChar(100)
  estimatedValue BigInt
  currency       String                @default("IDR") @db.VarChar(3)
  notes          String?
  visibility     InheritanceVisibility @default(heirs_only)
  documentUrl    String?
  // EPIC-021 Group D (#11) — optional link back to the source Asset this
  // inheritance record was picked from ("Pilih dari Aset" mode). Unenforced
  // FK, matching the Donation.accountId pattern elsewhere in this schema —
  // manual entry (no Asset pick) leaves this null.
  assetId        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  familyGroup    FamilyGroup           @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  heirs          InheritanceHeir[]

  @@index([familyGroupId])
  @@map("inheritance_assets")
}

model InheritanceHeir {
  id                 String           @id @default(uuid())
  inheritanceAssetId String
  name               String           @db.VarChar(100)
  relationship       String           @db.VarChar(100)
  sharePercent       Decimal          @db.Decimal(5, 2)
  // EPIC-021 Group D (Decision #9) — optional link to a family-group member
  // (User.id) alongside the free-text name/relationship. Unenforced FK, same
  // pattern as Donation.accountId.
  memberUserId       String?
  createdAt          DateTime         @default(now())
  inheritanceAsset   InheritanceAsset @relation(fields: [inheritanceAssetId], references: [id], onDelete: Cascade)

  @@index([inheritanceAssetId])
  @@map("inheritance_heirs")
}

model Donation {
  id              String       @id @default(uuid())
  familyGroupId   String
  type            DonationType
  recipient       String       @db.VarChar(200)
  amount          BigInt
  currency        String       @default("IDR") @db.VarChar(3)
  donatedAt       DateTime
  isTaxDeductible Boolean      @default(false)
  accountId       String?
  transactionId   String?
  receiptUrl      String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  familyGroup     FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId, donatedAt])
  @@map("donations")
}

model TaxRecord {
  id             String      @id @default(uuid())
  familyGroupId  String
  taxYear        Int
  grossIncome    BigInt
  ptkp           BigInt
  zakatDeduction BigInt      @default(0)
  netTax         BigInt      @default(0)
  sptStatus      SptStatus   @default(belum_lapor)
  documentUrl    String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  familyGroup    FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, taxYear])
  @@index([familyGroupId])
  @@map("tax_records")
}

model BankSync {
  id            String          @id @default(uuid())
  familyGroupId String
  fileName      String
  uploadedAt    DateTime        @default(now())
  rowCount      Int             @default(0)
  familyGroup   FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  entries       BankSyncEntry[]

  @@index([familyGroupId])
  @@map("bank_syncs")
}

model BankSyncEntry {
  id            String      @id @default(uuid())
  bankSyncId    String
  date          DateTime
  description   String
  amount        BigInt
  currency      String      @default("IDR")
  reconStatus   ReconStatus @default(unmatched)
  matchedTxId   String?
  suggestedTxId String?
  createdAt     DateTime    @default(now())
  bankSync      BankSync    @relation(fields: [bankSyncId], references: [id], onDelete: Cascade)

  @@index([bankSyncId])
  @@map("bank_sync_entries")
}

// EPIC-023 G2 (D17) — one saved column-mapping template per bank per family,
// so a returning statement from the same bank imports without remapping.
// Column identifiers are header text (case-insensitive match against the
// parsed file's header row); `dateFormat` disambiguates day/month order for
// non-ISO date columns (see reconciliation-parsers.ts).
model ReconciliationTemplate {
  id                String      @id @default(uuid())
  familyGroupId     String
  bankCode          String
  name              String
  dateColumn        String
  descriptionColumn String
  amountColumn      String
  dateFormat        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  familyGroup       FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, bankCode])
  @@index([familyGroupId])
  @@map("reconciliation_templates")
}

// EPIC-023 G3 (D16) — the family's own AI provider key, AES-256-GCM
// encrypted at rest via the existing CryptoService (same pattern as
// Account.maskedNumber). `encryptedKey` is never returned to the client;
// `keyHint` is a display-safe fragment (last 4 chars) only, never enough to
// reconstruct the key. One row per family (@unique) — switching provider
// overwrites the existing row rather than accumulating stale keys.
// Saved AI advisor sessions. Before these, "Mulai Baru" wiped the transcript
// with nothing behind it — the chat endpoint is stateless (the web app resent
// the whole history each turn and held it in React state), so closing the tab
// lost the conversation outright and there was no such thing as a previous
// session to go back to.
//
// Scoped by BOTH familyGroupId and userId: a family shares one AI key and one
// financial picture, but not each other's conversations. Every query filters
// on the pair, so one member can never list or open another's session even
// inside the same family.
//
// On storage: `AiMessage.content` is plaintext, unlike User.birthDate /
// monthlyIncome (AES-256-GCM via CryptoService). A transcript restates figures
// — net worth, monthly income, balances — that already sit unencrypted in
// `transactions`, `accounts`, and `assets`, so encrypting it would not raise
// the bar against anyone who can already read this database, while making the
// rows unsearchable. If that trade is ever revisited, the encryption belongs
// in AiConversationService, not the controller.
model AiConversation {
  id            String      @id @default(uuid())
  familyGroupId String
  userId        String
  // Derived from the first user turn (truncated), never model-authored — a
  // title generated by a second provider call would cost a request and could
  // fail independently of the chat that produced it.
  title         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AiMessage[]

  // Serves the only list query there is: this user's sessions in this family,
  // newest activity first.
  @@index([familyGroupId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AiMessageRole
  content        String
  // Mirrors the SSE `truncated` flag so a reopened session still shows the
  // "answer was cut off" notice instead of silently presenting a partial
  // answer as complete.
  truncated      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model FamilyAiKey {
  id            String      @id @default(uuid())
  familyGroupId String      @unique
  provider      AiProvider
  encryptedKey  String
  keyHint       String?
  /// The provider model this family chose, e.g. `gemini-2.5-flash-lite`.
  /// NULL means "whatever the code defaults to", which is what every family
  /// had before the picker existed — so an unset value must keep working.
  /// Cleared whenever the PROVIDER changes: an OpenAI model id is meaningless
  /// to Gemini, and carrying one across would 404 every call.
  model         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@map("family_ai_keys")
}

/// EPIC-030 — a Master-defined IAM role: which pages its members may see or
/// manage, and whether they see the whole family's data or only their own.
model AccessRole {
  id            String          @id @default(uuid())
  familyGroupId String
  name          String
  description   String?
  dataScope     AccessDataScope @default(all)
  /// Sparse page → level map ("none" | "view" | "manage"), validated by
  /// AccessPermissionsSchema in @wealthme/contracts on every write and read.
  permissions   Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  familyGroup   FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  members       Member[]

  @@unique([familyGroupId, name])
  @@index([familyGroupId])
  @@map("access_roles")
}

enum AccessDataScope {
  all
  own
}
