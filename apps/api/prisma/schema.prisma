generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  owner
  member
  admin_staff
}

enum AccountType {
  bank
  ewallet
  cash
  investment
  property
}

enum CategoryKind {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum BudgetPeriod {
  monthly
  weekly
  yearly
}

enum GoalStatus {
  on_track
  needs_boost
  achieved
  at_risk
}

enum AssetType {
  properti
  kendaraan
  elektronik
  perhiasan
  lainnya
}

enum InvestmentType {
  saham
  reksa_dana
  obligasi
  emas
  kripto
  lainnya
}

enum LiabilityType {
  kartu_kredit
  pinjaman_pribadi
  kpr
  kendaraan
  lainnya
}

enum InsuranceType {
  jiwa
  kesehatan
  kendaraan
  properti
  lainnya
}

enum InsuranceStatus {
  aktif
  tidak_aktif
  kadaluarsa
}

enum PremiumPeriod {
  monthly
  quarterly
  yearly
}

enum SplitStatus {
  open
  settled
}

enum ParticipantStatus {
  pending
  paid
}

enum InheritanceVisibility {
  private
  heirs_only
  all_members
}

enum DonationType {
  zakat_maal
  zakat_fitrah
  infaq
  sedekah
  wakaf
  lainnya
}

enum SptStatus {
  belum_lapor
  sudah_lapor
  terlambat
}

enum ReconStatus {
  matched
  unmatched
  suggested
}

enum CoaDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum CoaBudgetType {
  FIXED
  VARIABLE
  REIMBURSEMENT
}
// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  name           String
  emailVerified  Boolean     @default(false)
  image          String?
  passwordHash   String?
  googleId       String?     @unique
  avatarInitials String?
  phone          String?
  // birthDate/monthlyIncome are stored ciphertext (AES-256-GCM via CryptoService),
  // so they are String columns even though the values they represent are a date
  // and a number — see accounts.service.ts's Account.maskedNumber for the pattern.
  birthDate      String?
  gender         String?
  jobTitle       String?
  monthlyIncome  String?
  // Display currency preference (ISO 4217 code) — not sensitive, stored
  // plaintext unlike birthDate/monthlyIncome. Conversion rates come from the
  // mock FxPort, so any non-IDR display is always labeled indicative in the UI.
  currency       String      @default("IDR") @db.VarChar(3)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  memberships    Member[]
  sessions       BaSession[]
  baAccounts     BaAccount[]

  @@map("users")
}

model BaSession {
  id            String   @id @default(uuid())
  expiresAt     DateTime
  token         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ipAddress     String?
  userAgent     String?
  userId        String
  familyGroupId String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model BaAccount {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model FamilyGroup {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members            Member[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  goals              Goal[]
  notifications      Notification[]
  assets             Asset[]
  investments        Investment[]
  liabilities        Liability[]
  insurances         Insurance[]
  invitations        Invitation[]
  splitBills         SplitBill[]
  inheritanceAssets  InheritanceAsset[]
  donations          Donation[]
  taxRecords         TaxRecord[]
  bankSyncs          BankSync[]
  netWorthSnapshots  NetWorthSnapshot[]
  coaAccounts        CoaAccount[]

  @@map("family_groups")
}

model CoaAccount {
  id            String         @id @default(uuid())
  familyGroupId String
  code          String
  name          String
  groupNum      Int
  direction     CoaDirection
  budgetType    CoaBudgetType?
  parentCode    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  familyGroup   FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, code])
  @@index([familyGroupId])
  @@map("coa_accounts")
}

model Invitation {
  id            String      @id @default(uuid())
  token         String      @unique @default(uuid())
  familyGroupId String
  email         String
  role          Role        @default(member)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@index([email])
  @@map("invitations")
}

model Member {
  id            String      @id @default(uuid())
  userId        String
  familyGroupId String
  role          Role
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, familyGroupId])
  @@index([familyGroupId])
  @@map("members")
}

model Account {
  id            String        @id @default(uuid())
  familyGroupId String
  name          String
  type          AccountType
  institution   String?
  maskedNumber  String?
  balance       BigInt
  currency      String        @default("IDR")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  familyGroup   FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([familyGroupId, name])
  @@index([familyGroupId])
  @@map("accounts")
}

model Category {
  id            String        @id @default(uuid())
  familyGroupId String
  name          String
  kind          CategoryKind
  color         String?
  icon          String?
  createdAt     DateTime      @default(now())
  familyGroup   FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([familyGroupId, name, kind])
  @@index([familyGroupId])
  @@map("categories")
}

model Transaction {
  id            String          @id @default(uuid())
  familyGroupId String
  accountId     String
  categoryId    String?
  amount        BigInt
  type          TransactionType
  description   String?
  occurredAt    DateTime
  createdAt     DateTime        @default(now())
  familyGroup   FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([familyGroupId, occurredAt])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id            String       @id @default(uuid())
  familyGroupId String
  categoryId    String
  period        BudgetPeriod
  limitAmount   BigInt
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, categoryId, period])
  @@index([familyGroupId])
  @@map("budgets")
}

model Goal {
  id              String      @id @default(uuid())
  familyGroupId   String
  name            String
  icon            String?
  targetAmount    BigInt
  currentAmount   BigInt      @default(0)
  targetDate      DateTime?
  autoDebitAmount BigInt?
  lastAutoDebitAt DateTime?
  status          GoalStatus  @default(on_track)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  familyGroup     FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("goals")
}

model Notification {
  id            String      @id @default(uuid())
  familyGroupId String
  title         String
  body          String
  icon          String?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("notifications")
}

model Asset {
  id            String         @id @default(uuid())
  familyGroupId String
  name          String
  type          AssetType
  currentValue  BigInt
  currency      String         @default("IDR")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  familyGroup   FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  history       AssetHistory[]

  @@index([familyGroupId])
  @@map("assets")
}

model AssetHistory {
  id         String   @id @default(uuid())
  assetId    String
  value      BigInt
  recordedAt DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt])
  @@map("asset_history")
}

model NetWorthSnapshot {
  id               String      @id @default(uuid())
  familyGroupId    String
  capturedAt       DateTime    @default(now())
  totalCash        BigInt
  totalInvestments BigInt
  totalAssets      BigInt
  totalLiabilities BigInt
  netWorth         BigInt
  familyGroup      FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId, capturedAt])
  @@map("net_worth_snapshots")
}

model Investment {
  id               String            @id @default(uuid())
  familyGroupId    String
  ticker           String
  name             String
  type             InvestmentType
  quantity         Decimal           @db.Decimal(18, 8)
  costBasisPerUnit Decimal           @db.Decimal(18, 2)
  currency         String            @default("IDR")
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  familyGroup      FamilyGroup       @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  prices           InvestmentPrice[]

  @@index([familyGroupId])
  @@map("investments")
}

model InvestmentPrice {
  id           String     @id @default(uuid())
  investmentId String
  price        Decimal    @db.Decimal(18, 2)
  source       String     @default("mock")
  recordedAt   DateTime   @default(now())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, recordedAt])
  @@map("investment_prices")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  familyGroupId String?
  action        String
  entity        String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([familyGroupId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Liability {
  id               String        @id @default(uuid())
  familyGroupId    String
  name             String
  institution      String?
  type             LiabilityType
  totalDebt        BigInt
  remainingBalance BigInt
  minimumPayment   BigInt        @default(0)
  interestRate     Decimal       @default(0) @db.Decimal(5, 2)
  dueDate          DateTime?
  autoAdvanceDueDate Boolean     @default(false)
  notes            String?
  currency         String        @default("IDR")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  familyGroup      FamilyGroup   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("liabilities")
}

model Insurance {
  id              String          @id @default(uuid())
  familyGroupId   String
  name            String          @db.VarChar(150)
  provider        String?         @db.VarChar(150)
  type            InsuranceType
  status          InsuranceStatus @default(aktif)
  coverageAmount  BigInt?
  premiumAmount   BigInt
  premiumPeriod   PremiumPeriod   @default(monthly)
  renewalDate     DateTime?
  autoRenewDate   Boolean         @default(false)
  policyNumber    String?         @db.VarChar(100)
  notes           String?         @db.VarChar(500)
  currency        String          @default("IDR") @db.VarChar(3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  familyGroup     FamilyGroup     @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@map("insurances")
}

model SplitBill {
  id            String             @id @default(uuid())
  familyGroupId String
  title         String             @db.VarChar(200)
  totalAmount   BigInt
  currency      String             @default("IDR") @db.VarChar(3)
  shareToken    String             @unique @default(uuid())
  status        SplitStatus        @default(open)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  familyGroup   FamilyGroup        @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  participants  SplitParticipant[]

  @@index([familyGroupId])
  @@index([shareToken])
  @@map("split_bills")
}

model SplitParticipant {
  id           String            @id @default(uuid())
  splitBillId  String
  name         String            @db.VarChar(100)
  amountOwed   BigInt
  status       ParticipantStatus @default(pending)
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  splitBill    SplitBill         @relation(fields: [splitBillId], references: [id], onDelete: Cascade)

  @@index([splitBillId])
  @@map("split_participants")
}

model InheritanceAsset {
  id             String                @id @default(uuid())
  familyGroupId  String
  name           String                @db.VarChar(200)
  assetType      String                @db.VarChar(100)
  estimatedValue BigInt
  currency       String                @default("IDR") @db.VarChar(3)
  notes          String?
  visibility     InheritanceVisibility @default(heirs_only)
  documentUrl    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  familyGroup    FamilyGroup           @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  heirs          InheritanceHeir[]

  @@index([familyGroupId])
  @@map("inheritance_assets")
}

model InheritanceHeir {
  id                 String           @id @default(uuid())
  inheritanceAssetId String
  name               String           @db.VarChar(100)
  relationship       String           @db.VarChar(100)
  sharePercent       Decimal          @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  inheritanceAsset   InheritanceAsset @relation(fields: [inheritanceAssetId], references: [id], onDelete: Cascade)

  @@index([inheritanceAssetId])
  @@map("inheritance_heirs")
}

model Donation {
  id              String       @id @default(uuid())
  familyGroupId   String
  type            DonationType
  recipient       String       @db.VarChar(200)
  amount          BigInt
  currency        String       @default("IDR") @db.VarChar(3)
  donatedAt       DateTime
  isTaxDeductible Boolean      @default(false)
  accountId       String?
  transactionId   String?
  receiptUrl      String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  familyGroup     FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([familyGroupId, donatedAt])
  @@map("donations")
}

model TaxRecord {
  id             String      @id @default(uuid())
  familyGroupId  String
  taxYear        Int
  grossIncome    BigInt
  ptkp           BigInt
  zakatDeduction BigInt      @default(0)
  netTax         BigInt      @default(0)
  sptStatus      SptStatus   @default(belum_lapor)
  documentUrl    String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  familyGroup    FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, taxYear])
  @@index([familyGroupId])
  @@map("tax_records")
}

model BankSync {
  id            String         @id @default(uuid())
  familyGroupId String
  fileName      String
  uploadedAt    DateTime       @default(now())
  rowCount      Int            @default(0)
  familyGroup   FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  entries       BankSyncEntry[]

  @@index([familyGroupId])
  @@map("bank_syncs")
}

model BankSyncEntry {
  id              String      @id @default(uuid())
  bankSyncId      String
  date            DateTime
  description     String
  amount          BigInt
  currency        String      @default("IDR")
  reconStatus     ReconStatus @default(unmatched)
  matchedTxId     String?
  suggestedTxId   String?
  createdAt       DateTime    @default(now())
  bankSync        BankSync    @relation(fields: [bankSyncId], references: [id], onDelete: Cascade)

  @@index([bankSyncId])
  @@map("bank_sync_entries")
}
