// EPIC-023 F3 (D21) — "claimed" is the "saya sudah transfer" state: the
// recipient says they sent the money but NO income has posted yet (Honest
// UI mandate — a claim is a claim, not a payment). Only the owner's
// confirm action (SplitBillsService.confirmParticipant) can move a
// participant into "paid", and that is the ONLY transition that ever posts
// a real Transaction / touches Account.balance.
enum ParticipantStatus {
  pending
  claimed
  paid
}

enum InheritanceVisibility {
  private
  heirs_only
  all_members
}

enum DonationType {
  zakat_maal
  zakat_fitrah
  infaq
  sedekah
  wakaf
  // EPIC-023 F2 (D20, US-DON-6/7) — the obligatory Christian contribution
  // (persepuluhan/tithe, collected by a recognised church body). PP 60/2010
  // widens tax-deductible "sumbangan keagamaan" beyond zakat to any
  // OBLIGATORY religious contribution for a recognised religion, which is
  // why excluding this type from `TAX_DEDUCTIBLE_DONATION_TYPES` was wrong.
  // A voluntary Christian offering still has no dedicated type and stays
  // recorded as `lainnya` (never deductible) — see donations.service.ts.
  persepuluhan
  lainnya
}

// EPIC-023 F2 (D20, US-DON-6/7) — a family-level setting, not a per-user
// one: the donation page (and its calculator) reflects the FAMILY's
// religion, matching `FamilyGroup.goldPricePerGram`'s precedent for a
// family-wide manual setting. `islam` is the default for every
// PRE-EXISTING family (see `FamilyGroup.religion` below) so this feature
// never changes what an existing family already saw (the donation page
// showed the zakat calculator unconditionally before this enum existed) —
// an owner can correct it immediately via PATCH .../religion.
enum FamilyReligion {
  islam
  kristen
  katolik
  hindu
  buddha
  none
}

enum SptStatus {
  belum_lapor
  sudah_lapor
  terlambat
}

enum TaxMaritalStatus {
  TK
  K
  KI
}

enum TaxCalcMode {
  legacy
  detailed
}

