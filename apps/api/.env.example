# =============================================================================
# WealthMe — API App (apps/api) Environment Variables
# =============================================================================
# Copy this file to apps/api/.env and adjust as needed.
# NEVER commit .env — it is gitignored.
# Local-service defaults here match docker-compose.yml at the repo root.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────

# [REQUIRED] Node environment. Must be 'development', 'test', or 'production'.
NODE_ENV=development

# [REQUIRED] Port the NestJS HTTP server listens on.
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection URL (Prisma / TypeORM).
# Matches docker-compose.yml defaults; change for staging/production.
DATABASE_URL=postgresql://wealthme:postgres@localhost:5432/wealthme_dev

# ── Redis ─────────────────────────────────────────────────────────────────────

# [REQUIRED] Redis connection URL (BullMQ queues, caching).
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────

# [REQUIRED] Secret used to sign JWT access tokens.
# IMPORTANT: use a long random string in production; NEVER use the placeholder below.
JWT_SECRET=change-me-in-local-only-dev-secret

# [OPTIONAL] JWT access token expiry (default 15m).
JWT_EXPIRES_IN=15m

# [REQUIRED] Secret used to sign JWT refresh tokens.
JWT_REFRESH_SECRET=change-me-refresh-in-local-only-dev

# [OPTIONAL] JWT refresh token expiry (default 7d).
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────

# [REQUIRED] Google OAuth 2.0 client credentials.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# [OPTIONAL] Override the OAuth redirect URI (default matches PORT above).
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────

# [REQUIRED when file uploads are enabled] S3-compatible endpoint.
MINIO_ENDPOINT=http://localhost:9000

# [REQUIRED when file uploads are enabled] Access credentials.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# [REQUIRED when file uploads are enabled] Default bucket name.
MINIO_BUCKET=wealthme-uploads

# ── Mail ──────────────────────────────────────────────────────────────────────

# [OPTIONAL] SMTP host (defaults to MailHog in local dev).
MAIL_HOST=localhost

# [OPTIONAL] SMTP port (MailHog default 1025; production usually 587).
MAIL_PORT=1025

# [OPTIONAL] SMTP username (empty for MailHog).
MAIL_USER=

# [OPTIONAL] SMTP password (empty for MailHog). NEVER put a real password here.
MAIL_PASS=

# [OPTIONAL] Sender "From" address shown in outgoing emails.
MAIL_FROM=noreply@wealthme.local

# ── Web / CORS ────────────────────────────────────────────────────────────────

# [OPTIONAL] Allowed web origin for CORS (default http://localhost:3000).
WEB_ORIGIN=http://localhost:3000

# ── API Docs (dev only) ───────────────────────────────────────────────────────

# Swagger UI (dev only): http://localhost:4000/api/docs
# OpenAPI JSON:          http://localhost:4000/api/docs-json
