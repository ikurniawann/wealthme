# =============================================================================
# WealthMe API — e2e test environment
# =============================================================================
# Copy to apps/api/.env.test before running `pnpm --filter @wealthme/api test:e2e`.
# test/e2e/setup/global-setup.ts refuses to start without it (it runs
# `prisma migrate deploy` against DATABASE_URL first), and the specs wipe every
# table between cases — so point this at a THROWAWAY database, never at the one
# `pnpm dev` uses.
#
#   docker run -d --name wm-e2e-db -p 55433:5432 \
#     -e POSTGRES_USER=wm -e POSTGRES_PASSWORD=wm -e POSTGRES_DB=wme2e postgres:17
# =============================================================================

NODE_ENV=test

DATABASE_URL=postgresql://wm:wm@localhost:55433/wme2e?schema=public
DIRECT_URL=postgresql://wm:wm@localhost:55433/wme2e?schema=public
REDIS_URL=redis://localhost:6379

PORT=4010
WEB_ORIGIN=http://localhost:3000

# Any 32+ char values — these sign tokens that never leave the test process.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210
JWT_REFRESH_EXPIRES_IN=7d
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=testtest
MINIO_BUCKET=wealthme-uploads
STORAGE_DIR=/tmp/wm-e2e-storage

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@wealthme.local

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4010
API_URL=http://localhost:4010

# 64 hex chars = 32 bytes for AES-256-GCM.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Keep the tests off the network: the mock adapter returns a deterministic
# price per ticker instead of calling Yahoo Finance / CoinGecko.
USE_REAL_MARKET_DATA=false
